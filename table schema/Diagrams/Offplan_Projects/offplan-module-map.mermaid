%% Offplan Projects module map — files that classify, hint, execute, and test.
%% Companion note: offplan_projects.md
flowchart TB
    subgraph Entry
        SSE[sse_bridge]
        COG[cognitive_pipeline]
        THINK[nodes_think]
        ENH[nodes_enhance]
        INTENT[intent_classifier_llm]
        SSE --> COG
        COG --> THINK
        COG --> ENH
        THINK --> INTENT
    end

    subgraph ClassifyLayer
        QC[query_classifier]
        PERC[perception_prepass]
        PLAN[query_planner]
        MIL[mobility_intent_llm]
        MIO[multi_intent_orchestrator]
        CAM[context_aware_mobility]
        TW[time_windows_recipes]
        PERC --> QC
        QC --> PLAN
        QC --> MIL
        QC --> CAM
        MIO -.-> QC
        ENH --> TW
    end

    subgraph RouterLayer
        AGENT[agent_py]
        DA[domain_agents]
        SKILL[sql_agent_skills_OFFPLAN]
        MVP[mvp_scope_guard]
        SQLG[sql_guard]
        AGENT --> DA
        DA --> SKILL
        DA --> MVP
        DA --> SQLG
    end

    subgraph CatalogHints
        VAL[catalog_value_index]
        RES[catalog_resolution]
        DC[catalog_domain_context]
        PROF[offplan_projects_profiles_v1]
        VAL --> RES
        VAL --> DC
        PROF --> DC
    end

    subgraph BridgeLayer
        OMB[offplan_market_bridge]
        OGB[offplan_geo_bridge]
        RBT[rta_bridge_tools]
        RDY[readiness_resolver]
        RBT --> OGB
        RBT --> RDY
    end

    subgraph Verify
        T1[test_offplan_followup_routing]
        T2[test_offplan_market_bridge]
        T3[test_rta_offplan_bridges]
        GOLD[rta_offplan_golden_json]
    end

    COG --> QC
    QC --> VAL
    QC --> AGENT
    AGENT --> DA
    AGENT --> OMB
    AGENT --> RBT
    AGENT --> DC
    AGENT --> T1
    OMB --> T2
    RBT --> T3
    GOLD -.-> T3
