%% Location Intel hybrid fan-out — pure spatial vs CI-gap companion vs mobility hybrid.
%% Companion note: location_intel.md
flowchart TD
    Q[UserQuery] --> Path{hybrid_path}

    Path -->|"pure spatial POI catalog ranking"| Pure[exclusive_Send_location_intel]
    Path -->|"lifestyle schools what is X like"| CiOnly[exclusive_Send_communities_intel]
    Path -->|"buyer_fit with persona"| Buyer[communities_intel_plus_property_search]
    Path -->|"investor_intelligence"| Inv[market_intel_plus_communities_intel]
    Path -->|"rental_intel"| Rent[CI_plus_market_plus_property_search]
    Path -->|"CI plus POI-rank lat lng gap"| CiGap[communities_intel_plus_location_intel]
    Path -->|"mobility multi_intel plus location cue"| Multi[rta_plus_inferred_companions]
    Path -->|"area plus listings signal"| Fan[location_intel_plus_property_search]
    Path -->|"planner already 2+ domains"| Keep[preserve_plan_steps_domains]

    Buyer --> B1[communities_intel]
    Buyer --> B2[property_search]

    Inv --> I1[market_intel]
    Inv --> I2[communities_intel]

    Rent --> R1[communities_intel]
    Rent --> R2[market_intel]
    Rent --> R3[property_search]

    CiGap --> G1[communities_intel]
    CiGap --> G2[location_intel]

    Multi --> M1[rta_intel]
    Multi --> M2[location_intel_when_cue]
    Multi --> M3[communities_intel_when_lifestyle]
    Multi --> M4[market_intel_when_cue]
    Multi --> M5[offplan_projects_when_cue]

    Fan --> F1[location_intel]
    Fan --> F2[property_search]

    Keep --> K1[as_planned_domains]

    B1 --> Parallel[LangGraph_parallel_Sends]
    B2 --> Parallel
    I1 --> Parallel
    I2 --> Parallel
    R1 --> Parallel
    R2 --> Parallel
    R3 --> Parallel
    G1 --> Parallel
    G2 --> Parallel
    M1 --> Parallel
    M2 --> Parallel
    M3 --> Parallel
    M4 --> Parallel
    M5 --> Parallel
    F1 --> Parallel
    F2 --> Parallel
    K1 --> Parallel
    Pure --> Single[single_location_intel_Send]
    CiOnly --> CiSingle[single_communities_intel_Send]

    Parallel --> Results[operator_add_results]
    Single --> Results
    CiSingle --> Results

    Results --> Synth{domain_count}
    Synth -->|1| Direct[scrubbed_final_answer]
    Synth -->|2+| Merge[router_model_synthesize]
