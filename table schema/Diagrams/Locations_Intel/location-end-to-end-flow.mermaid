%% Location Intel end-to-end — chat → think → classify → Sends → ranking hold → synth.
%% Companion note: location_intel.md
flowchart TD
    Chat["POST /api/chat SSE"] --> Boot[boot_node_hydrate_session]
    Boot --> Think[think_node_intent_location_intel]
    Think --> Enhance[enhance_node_skip_FilterSpec_persona_slots]
    Enhance --> RAE{route_after_enhance}

    RAE -->|"location_intel analytical"| Core[propqa_core_node_skip_sql_false]
    RAE -->|"research flag on"| Research[research_branch_optional]
    RAE -->|"other clear intents"| Core
    RAE -->|"ambiguous"| Reason[reason_resolve_locations_describe_area]
    Reason --> Core
    Research --> Core

    Core --> Legacy[agent_get_workflow]
    Legacy --> Scope[check_mvp_scope]
    Scope -->|blocked| ScopeEnd[scope_or_schema_reply]
    Scope -->|ok| Classify[classify_query_or_planner]

    Classify --> C1{classify_paths}
    C1 -->|"pure spatial POI ranking"| LI[location_intel_only]
    C1 -->|"lifestyle schools what is X like"| CI[communities_intel_only]
    C1 -->|"buyer_fit persona"| Buyer[communities_intel_plus_property_search]
    C1 -->|"investor persona"| Inv[market_intel_plus_communities_intel]
    C1 -->|"rental persona"| Rent[CI_plus_MI_plus_property_search]
    C1 -->|"CI plus POI-rank gap"| CiGap[communities_intel_plus_location_intel]
    C1 -->|"mobility plus location cue"| Multi[multi_intel_hybrid_incl_LI]
    C1 -->|"area plus listings signal"| FanPS[location_intel_plus_property_search]

    LI --> Route[route_to_agents]
    CI --> Route
    Buyer --> Route
    Inv --> Route
    Rent --> Route
    CiGap --> Route
    Multi --> Route
    FanPS --> Route

    Route --> Nodes{domain_Sends}
    Nodes --> LiNode[location_intel_ReAct_prod]
    Nodes --> Companions[communities_intel_market_intel_property_search_rta_intel]

    LiNode --> Completeness[answer_completeness_ranking_hold]
    Completeness --> Synth[synthesize_results]
    Companions --> Synth

    Synth -->|"1 domain"| FinalDirect[final_answer_scrubbed]
    Synth -->|"2+ domains"| FinalMerge[router_model_merge_stream]
    FinalDirect --> Result[result_node_persona_overlay]
    FinalMerge --> Result
    ScopeEnd --> EndNode[END]
    Result --> EndNode
