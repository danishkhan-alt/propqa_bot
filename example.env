# Template for development.env, staging.env and production.env. Copy it, fill in the
# blank secrets, and set APP_ENV in .env to pick which file loads.

# App
DEBUG=true
BASE_URL=http://localhost:8000
APP_HOST=0.0.0.0
APP_PORT=8000
TIMEZONE=Asia/Dubai

# Read-only warehouse (text-to-SQL). Not the chatbot database.
AUDIT_DB_HOST=propqa-db-ins.ctse2sy0sgxv.me-central-1.rds.amazonaws.com
AUDIT_DB_PORT=54321
AUDIT_DB_DATABASE=postgres
AUDIT_DB_USERNAME=propqadb
AUDIT_DB_PASSWORD=
AUDIT_DB_SSLMODE=require
DB_SEARCH_PATH=public,ai_chatbot
SQL_ROW_CAP=100
SQL_TIMEOUT_MS=15000
GROUNDING_REGION=Dubai
GROUNDING_REFRESH_SECONDS=3600

# Chatbot database on this machine
CHAT_DB_HOST=127.0.0.1
CHAT_DB_PORT=5432
CHAT_DB_NAME=propqa_chatbot
CHAT_DB_USER=propqa
CHAT_DB_PASSWORD=
CHAT_DB_SSLMODE=disable
CHAT_DB_POOL_MIN=1
CHAT_DB_POOL_MAX=10

# Caches
REDIS_URL=redis://localhost:6379/0
CACHE_KEY_PREFIX=propqa:development

# Auth. Each environment has its own signing key, so a token from one is rejected by the others.
JWT_SIGNING_KEY=
JWT_ISSUER=propqa
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_DAYS=30

# LLM provider: anthropic | openai
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MAX_OUTPUT_TOKENS=4096
AI_MODEL=gpt-4.1
ROUTER_MODEL=gpt-5.4-mini
AI_REPLY_EFFORT=low
AI_SQL_EFFORT=medium
ROUTER_EFFORT=low

# Domain router: jev | llm
DOMAIN_ROUTER=jev
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=4000

# Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOGS_DIR=logs
LOG_MAX_BYTES=104857600
LOG_BACKUP_COUNT=10

# Rate limiting. Proxy count is how many proxies we run in front of the API.
RATELIMIT_ENABLED=true
TRUSTED_PROXY_COUNT=0

# Visitor identity
VISITOR_COOKIE_NAME=propqa_visitor_id
VISITOR_COOKIE_MAX_AGE=31536000
